NODE_ENV=development
PORT=3001

BOT_TOKEN=[TELEGRAM_BOT_TOKEN]
BOT_API_SECRET=[LONG_RANDOM_INTERNAL_BOT_SECRET]
ADMIN_TELEGRAM_IDS=[ADMIN_TELEGRAM_IDS]

MONGODB_URI=mongodb://mongodb:27017/digital_store?replicaSet=rs0
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=[JWT_ACCESS_SECRET]
JWT_REFRESH_SECRET=[JWT_REFRESH_SECRET]
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Exactly 32 UTF-8 bytes, 64 hex characters, or base64 encoding of 32 bytes.
ENCRYPTION_KEY=[32_BYTE_ENCRYPTION_KEY]
ENCRYPTION_KEY_VERSION=1
# Keep old versions during key rotation, for example {"1":"old...","2":"new..."}.
# ENCRYPTION_KEYS_JSON={"1":"...","2":"..."}
# A stable 32-byte HMAC key. Never rotate it without a duplicate-detection migration.
PAYLOAD_HASH_KEY=[32_BYTE_PAYLOAD_HASH_KEY]

PAYMENT_WEBHOOK_SECRET=[PAYMENT_WEBHOOK_SECRET]
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
SHOP_NAME=Digital Store
DELIVERY_CONCURRENCY=5
DELIVERY_ATTEMPTS=6
DELIVERY_BACKOFF_MS=5000

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=[CHANGE_ME]
SEED_USER_TELEGRAM_ID=100000001
