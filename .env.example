NODE_ENV=development
PORT=3001

# `server` = Docker/VPS + Redis/BullMQ worker (default).
# `serverless` = Vercel + MongoDB Atlas + QStash; Redis is not required.
APP_RUNTIME=server
# Limit connections per warm application instance. Use 5-10 on Vercel/Atlas.
MONGODB_MAX_POOL_SIZE=20

# Optional bootstrap/fallback token. It can be configured later from the admin page.
BOT_TOKEN=
BOT_API_SECRET=[LONG_RANDOM_INTERNAL_BOT_SECRET]
ADMIN_TELEGRAM_IDS=[ADMIN_TELEGRAM_IDS]

MONGODB_URI=mongodb://mongodb:27017/digital_store?replicaSet=rs0
# Required only when APP_RUNTIME=server (Docker/VPS worker mode).
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=[JWT_ACCESS_SECRET]
JWT_REFRESH_SECRET=[JWT_REFRESH_SECRET]
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Exactly 32 UTF-8 bytes, 64 hex characters, or base64 encoding of 32 bytes.
ENCRYPTION_KEY=[32_BYTE_ENCRYPTION_KEY]
ENCRYPTION_KEY_VERSION=1
# Keep old versions during key rotation, for example {"1":"old...","2":"new..."}.
# ENCRYPTION_KEYS_JSON={"1":"...","2":"..."}
# A stable 32-byte HMAC key. Never rotate it without a duplicate-detection migration.
PAYLOAD_HASH_KEY=[32_BYTE_PAYLOAD_HASH_KEY]

PAYMENT_WEBHOOK_SECRET=[PAYMENT_WEBHOOK_SECRET]
# Cake API token used to verify the callback `signature` header. Keep it secret.
TOKEN_API_BANK=
BANK_ID=
BANK_ACCOUNT_NO=
BANK_QR_TEMPLATE=compact2
BANK_ACCOUNT_NAME=
BANK_QR_AMOUNT=0
BANK_QR_DESCRIPTION=
BANK_TOPUP_TTL_MINUTES=20
WEB_APP_URL=http://localhost:3000
API_URL=http://localhost:3001
SHOP_NAME=Digital Store
DELIVERY_CONCURRENCY=5
DELIVERY_ATTEMPTS=6
DELIVERY_BACKOFF_MS=5000
BOT_CONFIG_POLL_SECONDS=15

# ---------------------------------------------------------------------------
# Vercel serverless mode (set APP_RUNTIME=serverless in Vercel Environment
# Variables; do not commit real values).
# Atlas must be a replica set because checkout and wallet credit use Mongo
# transactions. Use the same public HTTPS domain for WEB_APP_URL/API_URL.
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/digital_store?retryWrites=true&w=majority
# MONGODB_MAX_POOL_SIZE=5
# WEB_APP_URL=https://shop.example.com
# API_URL=https://shop.example.com
# TASK_BASE_URL=https://shop.example.com
# The endpoint/URL/token lines below are optional bootstrap fallbacks; after
# the first deploy they can be encrypted/saved from Admin > Runtime config.
# TELEGRAM_WEBHOOK_URL=https://shop.example.com/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=[URL_SAFE_RANDOM_32+_CHARACTERS] # HMAC seed; per-bot Telegram header is derived
# QSTASH_TOKEN=[UPSTASH_QSTASH_TOKEN]
# QSTASH_URL=https://qstash-us-east-1.upstash.io # US; use https://qstash.upstash.io for EU
# TASK_QUEUE_SECRET=[LONG_RANDOM_INTERNAL_TASK_SECRET]
# CRON_SECRET=[LONG_RANDOM_CRON_SECRET]
#
# Do not set NEXT_PUBLIC_API_URL for the single Vercel project: admin defaults
# to the same-origin /api bridge. Bank credit is driven by the signed Cake
# callback, not by a Vercel/QStash polling schedule.

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=[CHANGE_ME]
SEED_USER_TELEGRAM_ID=100000001
