{
  "name": "digital-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.2.0"
  },
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:api": "bun --watch apps/api/src/main.ts",
    "dev:bot": "bun --watch apps/bot/src/main.ts",
    "dev:admin": "bun --cwd apps/admin-web dev",
    "build": "bun run typecheck && bun --cwd apps/admin-web build",
    "typecheck": "bunx tsc -p tsconfig.backend.json --noEmit && bunx tsc -p apps/admin-web/tsconfig.json --noEmit",
    "lint": "bunx eslint apps packages --ext .ts,.tsx",
    "test": "bun test",
    "test:integration": "RUN_INTEGRATION=1 bun test tests/integration",
    "migration:up": "bun packages/database/src/migrations/cli.ts up",
    "migration:down": "bun packages/database/src/migrations/cli.ts down",
    "migration:status": "bun packages/database/src/migrations/cli.ts status",
    "seed": "bun packages/database/src/seed.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/platform-fastify": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@store/config": "workspace:*",
    "@store/database": "workspace:*",
    "@store/encryption": "workspace:*",
    "@store/shared": "workspace:*",
    "@tailwindcss/postcss": "^4.3.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "fastify": "^5.6.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.18.1",
    "next": "^16.2.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tailwindcss": "^4.3.0",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.2.6",
    "mongodb-memory-server": "^10.2.0",
    "typescript": "^6.0.3"
  }
}
